---
import { PROJECTS } from "../data/site-content";
---

<section class="project-vision section" aria-labelledby="project-strip-title">
  <div class="container">
    <div class="kicker reveal">
      <span class="kicker__label">Where We Are Going</span>
    </div>

    <div class="section-head reveal">
      <h2 id="project-strip-title">The road starts here.</h2>
      <p class="section-head__lede">
        Bozeman, Mojave, and St. Louis show how one hospitality standard can meet different
        corridors, communities, and stages of development.
      </p>
    </div>
  </div>

  <ol class="project-strip" aria-label="Rangeway projects">
    {PROJECTS.map((project) => (
      <li>
        <a href={project.href} target="_blank" rel="noopener noreferrer">
          <strong>{project.name}</strong>
          <span>{project.status}</span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .project-vision {
    padding-bottom: 0;
    background: var(--color-roadmap);
  }

  @media (min-width: 901px) {
    .project-vision .section-head {
      align-items: start;
    }
  }

  .project-strip {
    margin: 0;
    padding: 0 var(--gutter);
    list-style: none;
    color: var(--fg-on-dark-1);
    background: var(--color-highway);
  }

  .project-strip li + li {
    border-top: 1px solid var(--border-on-dark);
  }

  .project-strip a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-5);
    align-items: baseline;
    padding: clamp(24px, 3vw, 40px) 0;
  }

  .project-strip a:hover {
    color: var(--color-sun);
  }

  .project-strip strong {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2.7rem);
    line-height: var(--lh-subhead);
  }

  .project-strip span {
    font-family: var(--font-heading);
    font-size: var(--fs-caption);
    font-weight: 700;
    letter-spacing: var(--ls-allcaps);
    text-transform: uppercase;
    color: var(--fg-on-dark-2);
  }

  @media (max-width: 520px) {
    .project-strip a {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>

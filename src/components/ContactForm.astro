---
interface Props {
  compact?: boolean;
  /** Prefill the interest select (must match an option label). */
  defaultInterest?: string;
  /** Subject line for Formsubmit. */
  subject?: string;
  /** Show host-oriented property fields. */
  hostMode?: boolean;
}

const {
  compact = false,
  defaultInterest = "",
  subject = "New Rangeway Website Inquiry",
  hostMode = false
} = Astro.props;

const thanksUrl = new URL("/contact/thanks/", Astro.site).toString();
---

<form
  class:list={["contact-form", { "contact-form--compact": compact, "contact-form--host": hostMode }]}
  action="https://formsubmit.co/hello@rangeway.co"
  method="POST"
  data-contact-form
>
  <input type="hidden" name="_subject" value={subject} />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="true" />
  <input type="hidden" name="_next" value={thanksUrl} />
  <input
    type="text"
    name="_honey"
    class="contact-form__honey"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  <div class="contact-form__row">
    <label>
      <span>Name</span>
      <input type="text" name="name" required autocomplete="name" />
    </label>
    <label>
      <span>Email</span>
      <input type="email" name="email" required autocomplete="email" />
    </label>
  </div>

  {
    hostMode ? (
      <>
        <input type="hidden" name="interest" value="Potential Partner" />
        <div class="contact-form__row">
          <label>
            <span>Property or company</span>
            <input type="text" name="property" required autocomplete="organization" />
          </label>
          <label>
            <span>Location</span>
            <input type="text" name="location" required placeholder="City, state" />
          </label>
        </div>
        <label>
          <span>Property type</span>
          <select name="property_type" required>
            <option value="">Select one</option>
            <option>Resort or lodge</option>
            <option>Boutique hotel or inn</option>
            <option>Highway or corridor property</option>
            <option>Mixed-use or other</option>
          </select>
        </label>
      </>
    ) : (
      <label>
        <span>Interest</span>
        <select name="interest" required>
          <option value="" selected={!defaultInterest}>Select one</option>
          {["EV Driver", "Potential Partner", "Investor", "Careers", "Media", "Other"].map((opt) => (
            <option value={opt} selected={defaultInterest === opt}>{opt}</option>
          ))}
        </select>
      </label>
    )
  }

  <label>
    <span>{hostMode ? "Tell us about the property" : "Message"}</span>
    <textarea
      name="message"
      rows={hostMode ? 6 : 5}
      required
      placeholder={
        hostMode
          ? "Location, size, the guests you serve, and what brought Rangeway to mind."
          : undefined
      }
    ></textarea>
  </label>

  <div class="contact-form__actions">
    <button type="submit" class="btn btn-warm" data-submit>
      <span data-submit-label>{hostMode ? "Inquire about hosting" : "Send message"}</span>
    </button>
    <p class="contact-form__status" data-status hidden aria-live="polite"></p>
  </div>
</form>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    width: 100%;
    max-width: 600px;
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    font-family: var(--font-body);
    font-size: 1.05rem;
    padding: 10px 2px 12px;
    border: 0;
    border-bottom: 1px solid var(--color-border-strong);
    border-radius: 0;
    background: transparent;
    color: var(--color-text);
    width: 100%;
    transition: border-color 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
    text-transform: none;
    letter-spacing: 0;
    font-weight: 400;
  }

  .contact-form input::placeholder,
  .contact-form textarea::placeholder {
    color: var(--color-text-muted);
    opacity: 0.6;
  }

  .contact-form input:focus,
  .contact-form select:focus,
  .contact-form textarea:focus {
    outline: 2px solid var(--accent-on-light);
    outline-offset: 4px;
    border-bottom-color: var(--accent-on-light);
    box-shadow: 0 1px 0 0 var(--accent-on-light);
  }

  .contact-form textarea {
    resize: vertical;
    min-height: 120px;
  }

  .contact-form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .contact-form__status {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .contact-form.is-sending .contact-form__status {
    color: var(--accent-on-light);
  }

  .contact-form__honey {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 560px) {
    .contact-form__row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
    const submit = form.querySelector<HTMLButtonElement>("[data-submit]");
    const label = form.querySelector<HTMLElement>("[data-submit-label]");
    const status = form.querySelector<HTMLElement>("[data-status]");
    const idleLabel = label?.textContent ?? "Send message";

    form.addEventListener("submit", () => {
      form.classList.add("is-sending");
      if (submit) submit.disabled = true;
      if (label) label.textContent = "Sending…";
      if (status) {
        status.hidden = false;
        status.textContent = "Routing your note. You will land on a confirmation page next.";
      }
    });

    window.addEventListener("pageshow", () => {
      form.classList.remove("is-sending");
      if (submit) submit.disabled = false;
      if (label) label.textContent = idleLabel;
      if (status) {
        status.hidden = true;
        status.textContent = "";
      }
    });
  });
</script>

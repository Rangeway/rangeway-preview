---
import PathMark from "./PathMark.astro";
import { LINKS } from "../config";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { href: "/network", label: "The Network", match: "/network" },
  { href: "/our-story", label: "Our Story", match: "/our-story" },
  { href: "/team", label: "Team", match: "/team" },
  { href: "/partners", label: "Partners", match: "/partners" },
  { href: "/investors", label: "Investors", match: "/investors" },
  { href: LINKS.newsroom, label: "Newsroom", external: true },
  { href: "/contact", label: "Contact", match: "/contact" }
];

function isActive(match?: string) {
  if (!match) return false;
  if (match === "/") return pathname === "/";
  return pathname === match || pathname.startsWith(`${match}/`);
}
---

<header class="masthead" data-nav>
  <div class="masthead__inner">
    <a class="masthead__brand" href="/" aria-label="Rangeway home">
      <PathMark size={24} color="currentColor" accent="#F4A855" />
      <span class="masthead__wordmark">Rangeway</span>
    </a>

    <nav class="masthead__nav" aria-label="Primary">
      <ul>
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class:list={[{ "is-active": isActive(l.match) }]}
              aria-current={isActive(l.match) ? "page" : undefined}
              {...(l.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="masthead__actions">
      <a class="masthead__cta" href="/partners#host">Host</a>
      <button
        class="masthead__toggle"
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label="Open menu"
        data-toggle
      >
        <span class="masthead__toggle-label" data-toggle-label>Menu</span>
      </button>
    </div>
  </div>

  <div class="menu" id="site-menu" hidden data-menu>
    <div class="menu__inner">
      <nav aria-label="Menu">
        <ol class="menu__list">
          {links.map((l) => (
            <li>
              <a
                href={l.href}
                class:list={[{ "is-active": isActive(l.match) }]}
                aria-current={isActive(l.match) ? "page" : undefined}
                {...(l.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                <span class="menu__label">{l.label}</span>
              </a>
            </li>
          ))}
          <li>
            <a href="/partners#host">
              <span class="menu__label">Host a Rangeway</span>
            </a>
          </li>
        </ol>
      </nav>
      <div class="menu__foot">
        <div class="menu__social">
          <a href={LINKS.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
          <a href={LINKS.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href={LINKS.x} target="_blank" rel="noopener noreferrer">X</a>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .masthead {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 80;
    height: var(--nav-height);
    color: var(--color-white);
    border-bottom: 1px solid transparent;
    transition: background var(--dur-med) var(--ease-standard),
      color var(--dur-med) var(--ease-standard),
      border-color var(--dur-med) var(--ease-standard);
  }

  .masthead.is-scrolled,
  .masthead.is-open,
  :global(body:not(.has-hero)) .masthead {
    background: var(--surface-page);
    color: var(--color-text);
    border-bottom-color: var(--color-border-strong);
  }

  :global(body) .masthead.is-open {
    background: var(--color-ink);
    color: var(--color-white);
    border-bottom-color: var(--border-on-dark);
  }

  .masthead__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .masthead__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: currentColor;
    font-family: var(--font-heading);
    font-weight: 800;
  }

  .masthead__brand:hover {
    color: currentColor;
    opacity: 0.85;
  }

  .masthead__wordmark {
    font-size: 1.3rem;
    letter-spacing: -0.01em;
  }

  .masthead__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: clamp(16px, 2vw, 32px);
  }

  .masthead__nav a {
    font-family: var(--font-heading);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: var(--ls-allcaps);
    text-transform: uppercase;
    color: currentColor;
    opacity: 0.85;
    padding: 6px 0;
    border-bottom: 1px solid transparent;
  }

  .masthead__nav a:hover,
  .masthead__nav a.is-active {
    opacity: 1;
    color: currentColor;
    border-bottom-color: var(--color-warm);
  }

  .masthead__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .masthead__cta {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 8px 18px;
    border-radius: var(--radius-pill);
    background: var(--color-warm);
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: var(--ls-allcaps);
    text-transform: uppercase;
  }

  .masthead__cta:hover {
    background: var(--color-warm-lite);
    color: var(--color-ink);
  }

  .masthead.is-open .masthead__cta {
    display: none;
  }

  .masthead__toggle {
    display: none;
    align-items: center;
    gap: 8px;
    min-height: 42px;
    padding: 8px 16px;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    color: currentColor;
    font-family: var(--font-heading);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: var(--ls-allcaps);
    text-transform: uppercase;
  }

  .menu {
    position: fixed;
    inset: var(--nav-height) 0 0 0;
    background: var(--color-ink);
    color: var(--color-cream);
    overflow-y: auto;
    z-index: 79;
  }

  .menu[hidden] {
    display: none;
  }

  .menu__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: clamp(32px, 6vw, 72px) var(--gutter) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    min-height: calc(100% - 1px);
  }

  .menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .menu__list a {
    display: flex;
    align-items: baseline;
    gap: var(--space-5);
    padding: clamp(14px, 2.5vw, 22px) 0;
    border-top: 1px solid var(--border-on-dark);
    color: var(--fg-on-dark-1);
  }

  .menu__list li:last-child a {
    border-bottom: 1px solid var(--border-on-dark);
  }

  .menu__label {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(1.7rem, 5.5vw, 3rem);
    letter-spacing: var(--ls-heading);
    line-height: 1.05;
  }

  .menu__list a:hover .menu__label,
  .menu__list a.is-active .menu__label {
    color: var(--color-warm);
  }

  .menu__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .menu__social {
    display: flex;
    gap: var(--space-5);
  }

  .menu__social a {
    font-family: var(--font-heading);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: var(--ls-allcaps);
    text-transform: uppercase;
    color: var(--fg-on-dark-3);
  }

  .menu__social a:hover {
    color: var(--color-warm);
  }

  @media (max-width: 1100px) {
    .masthead__nav {
      display: none;
    }

    .masthead__toggle {
      display: inline-flex;
    }
  }

  @media (max-width: 480px) {
    .masthead__wordmark {
      display: none;
    }

    .masthead__inner {
      gap: var(--space-3);
    }

    .masthead__toggle {
      padding: 8px 12px;
    }

    .masthead__cta {
      padding: 8px 12px;
    }
  }
</style>

<script>
  const masthead = document.querySelector<HTMLElement>("[data-nav]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-toggle]");
  const toggleLabel = document.querySelector<HTMLElement>("[data-toggle-label]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");

  if (masthead) {
    const onScroll = () => {
      masthead.classList.toggle("is-scrolled", window.scrollY > 24);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  if (toggle && menu && masthead) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      masthead.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      if (toggleLabel) toggleLabel.textContent = open ? "Close" : "Menu";
      document.body.style.overflow = open ? "hidden" : "";
    };

    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      setOpen(menu.hidden);
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu.hidden) setOpen(false);
    });
  }
</script>

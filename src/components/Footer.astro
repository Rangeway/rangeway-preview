---
import { CLIMATIZE_URL, LINKS } from "../config";
const year = new Date().getFullYear();
---

<footer class="folio-footer">
  <div class="container">
    <div class="folio-footer__top">
      <p class="folio-footer__tag">Travel farther,<br />stop better.</p>

      <div class="folio-footer__columns">
        <div>
          <h3>Explore</h3>
          <ul>
            <li><a href="/network">The Network</a></li>
            <li><a href="/mojave">Rangeway Mojave</a></li>
            <li><a href="/our-story">Our Story</a></li>
            <li><a href="/team">Team</a></li>
            <li><a href="/partners">Partners</a></li>
          </ul>
        </div>
        <div>
          <h3>Company</h3>
          <ul>
            <li><a href="/investors">Investors</a></li>
            <li><a href={LINKS.linkedinJobs} target="_blank" rel="noopener">Careers</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div>
          <h3>Follow along</h3>
          <ul>
            <li><a href={LINKS.fieldNotes} target="_blank" rel="noopener">Field Notes</a></li>
            <li><a href={LINKS.newsroom} target="_blank" rel="noopener">Newsroom</a></li>
            <li><a href={LINKS.instagram} target="_blank" rel="noopener">Instagram</a></li>
            <li><a href={LINKS.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
            <li><a href={LINKS.x} target="_blank" rel="noopener">X</a></li>
          </ul>
        </div>
        <div>
          <h3>Reach us</h3>
          <address>
            2661 Market Street, STE 85787<br />
            San Francisco, CA 94114
          </address>
          <ul>
            <li><a href="tel:+16504206300">(650) 420-6300</a></li>
            <li><a href="mailto:hello@rangeway.co">hello@rangeway.co</a></li>
          </ul>
        </div>
      </div>
    </div>

    <a class="folio-footer__wordmark" href="/" aria-label="Rangeway home">Rangeway</a>

    <div class="folio-footer__legal">
      <p>© {year} Rangeway Energy, Inc. All rights reserved.</p>
      <p class="folio-footer__legal-links">
        <a href="/commitments">Our Commitments</a>
        <span aria-hidden="true">·</span>
        <a href="/privacy">Privacy Policy</a>
        <span aria-hidden="true">·</span>
        <a href="/terms">Terms of Service</a>
      </p>
    </div>

    <div class="folio-footer__disclosure">
      <p>
        Rangeway Energy, Inc. is raising capital on <a href={CLIMATIZE_URL} target="_blank" rel="noopener">Climatize</a> to fund Rangeway Mojave, the first location in the Rangeway network. This communication is for informational purposes only and is not an offer to sell, nor a solicitation of an offer to buy, any security. Offers may only be made through the Climatize platform. Visit <a href={CLIMATIZE_URL} target="_blank" rel="noopener">climatize.earth</a> for the full offering details, including risk factors. Investing involves risk, including possible loss of principal.
      </p>
    </div>
  </div>
</footer>

<style>
  .folio-footer {
    background: var(--color-ink);
    color: var(--color-cream);
    padding-top: clamp(72px, 9vw, 128px);
    overflow: hidden;
  }

  .folio-footer__top {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--space-8) clamp(40px, 6vw, 120px);
    padding-bottom: clamp(56px, 7vw, 96px);
  }

  .folio-footer__tag {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    line-height: 1.05;
    letter-spacing: var(--ls-heading);
    color: var(--fg-on-dark-1);
  }

  .folio-footer__columns {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .folio-footer h3 {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-warm);
    margin: 0 0 var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-on-dark);
  }

  .folio-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: 0.95rem;
  }

  .folio-footer ul a {
    color: var(--fg-on-dark-2);
  }

  .folio-footer ul a:hover {
    color: var(--color-warm);
  }

  .folio-footer address {
    font-style: normal;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--fg-on-dark-2);
    margin: 0 0 var(--space-3);
  }

  /* Signature: the wordmark set at folio scale across the footer */
  .folio-footer__wordmark {
    display: block;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(4rem, 14.5vw, 15rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--fg-on-dark-1);
    text-align: center;
    border-top: 1px solid var(--border-on-dark);
    padding-top: clamp(32px, 4vw, 56px);
    margin-bottom: clamp(32px, 4vw, 56px);
    transition: color var(--dur-med) var(--ease-standard);
  }

  .folio-footer__wordmark:hover {
    color: var(--color-warm);
  }

  .folio-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    border-top: 1px solid var(--border-on-dark);
    padding: var(--space-5) 0;
    font-size: 0.85rem;
    color: var(--fg-on-dark-3);
  }

  .folio-footer__legal p {
    margin: 0;
  }

  .folio-footer__legal-links {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .folio-footer__legal-links a {
    color: var(--fg-on-dark-2);
  }

  .folio-footer__legal-links a:hover {
    color: var(--color-warm);
  }

  .folio-footer__disclosure {
    padding: var(--space-5) 0 var(--space-7);
    border-top: 1px solid rgba(251, 247, 241, 0.08);
  }

  .folio-footer__disclosure p {
    margin: 0;
    font-size: 0.76rem;
    line-height: 1.65;
    color: var(--fg-on-dark-3);
    max-width: 96ch;
  }

  .folio-footer__disclosure a {
    color: var(--fg-on-dark-2);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .folio-footer__disclosure a:hover {
    color: var(--color-warm);
  }

  @media (max-width: 1000px) {
    .folio-footer__top {
      grid-template-columns: 1fr;
    }

    .folio-footer__columns {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-7) var(--space-6);
    }
  }

  @media (max-width: 520px) {
    .folio-footer__columns {
      grid-template-columns: 1fr;
    }
  }
</style>

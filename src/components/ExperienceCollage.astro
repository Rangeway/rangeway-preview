---
import ResponsiveImage from "./ResponsiveImage.astro";
import type { GuideImage } from "./homepage-images";

interface Props {
  images: readonly GuideImage[];
}

const { images } = Astro.props;
---

<section class="experience-collage section" aria-labelledby="experience-collage-title">
  <div class="container">
    <div class="kicker reveal">
      <span class="kicker__label">The Experience</span>
    </div>

    <div class="section-head reveal">
      <h2 id="experience-collage-title">A better place to pause.</h2>
      <p class="section-head__lede">
        Rangeway treats charging time as time worth caring for. Warm rooms, thoughtful light,
        and a clear path back to the road make the stop part of the journey.
      </p>
    </div>

    <div class="experience-collage__images">
      {images.map((image) => (
        <figure>
          <div class="experience-collage__frame">
            <ResponsiveImage
              src={image.src}
              alt={image.alt}
              loading="lazy"
              sizes="(max-width: 700px) 100vw, 50vw"
              style={image.focalPosition ? `object-position: ${image.focalPosition}` : undefined}
            />
          </div>
          <figcaption>{image.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .experience-collage figcaption {
    font-family: var(--font-heading);
    font-size: var(--fs-caption);
    font-weight: 700;
    letter-spacing: var(--ls-allcaps);
    text-transform: uppercase;
  }

  .experience-collage__images {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 64px);
    align-items: start;
  }

  .experience-collage figure {
    margin: 0;
  }

  .experience-collage__frame {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--surface-alt);
  }

  .experience-collage__frame :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .experience-collage__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .experience-collage figcaption {
    padding-top: var(--space-3);
    color: var(--color-text-muted);
  }

  @media (max-width: 700px) {
    .experience-collage__images {
      grid-template-columns: 1fr;
    }
  }
</style>

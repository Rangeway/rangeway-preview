---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  image: string;
  imageAlt: string;
  /** Chapter index shown in the kicker, e.g. "02" */
  index?: string;
  /** Caption strip under the image, e.g. "Basecamp · Antelope Valley, California" */
  caption?: string;
  align?: "left" | "center";
  scrim?: "default" | "strong";
}

const {
  eyebrow,
  title,
  lede,
  image,
  imageAlt,
  index,
  caption,
  scrim = "default"
} = Astro.props;
---

<section class={`chapter chapter--scrim-${scrim}`}>
  <div class="chapter__media">
    <img src={image} alt={imageAlt} fetchpriority="high" />
    <div class="chapter__scrim"></div>
  </div>

  <div class="container chapter__inner">
    <div class="chapter__kicker">
      <span class="chapter__index">{index ?? "Rangeway"}</span>
      <span class="chapter__label">{eyebrow}</span>
    </div>
    <div class="chapter__body">
      <h1>{title}</h1>
      {lede && <p class="chapter__lede">{lede}</p>}
    </div>
    <slot />
  </div>

  {caption && (
    <div class="container">
      <p class="chapter__caption">
        <strong>Plate</strong>
        <span>{caption}</span>
      </p>
    </div>
  )}
</section>

<style>
  .chapter {
    position: relative;
    color: var(--color-cream);
    background: var(--color-ink);
    margin-top: calc(-1 * (var(--nav-height) + 24px));
    padding-bottom: 0;
  }

  .chapter__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .chapter__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .chapter__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(23, 21, 20, 0.6) 0%, rgba(23, 21, 20, 0.18) 38%, rgba(23, 21, 20, 0.86) 100%);
  }

  .chapter--scrim-strong .chapter__scrim {
    background:
      linear-gradient(180deg, rgba(23, 21, 20, 0.72) 0%, rgba(23, 21, 20, 0.42) 40%, rgba(23, 21, 20, 0.92) 100%);
  }

  .chapter__inner {
    position: relative;
    z-index: 1;
    min-height: min(78vh, 820px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: calc(var(--nav-height) + 80px);
    padding-bottom: clamp(48px, 6vw, 88px);
  }

  /* Kicker rendered over the image: hairline + index + tracked label */
  .chapter__kicker {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid rgba(251, 247, 241, 0.42);
    margin-bottom: clamp(24px, 4vw, 48px);
    font-family: var(--font-heading);
    font-size: var(--fs-eyebrow);
    font-weight: 700;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
  }

  .chapter__index {
    color: var(--color-warm);
    font-variant-numeric: tabular-nums;
  }

  .chapter__label {
    text-align: right;
    color: var(--fg-on-dark-1);
  }

  .chapter__body {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--space-5) clamp(40px, 6vw, 96px);
    align-items: end;
  }

  .chapter h1 {
    color: var(--fg-on-dark-1);
    font-size: var(--fs-display);
    font-weight: 800;
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    margin: 0;
  }

  .chapter__lede {
    margin: 0;
    font-size: clamp(1.05rem, 1.4vw, 1.22rem);
    line-height: 1.6;
    max-width: 44ch;
    color: var(--fg-on-dark-2);
  }

  /* Plate caption strip under the image, on the ink base */
  .chapter__caption {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin: 0;
    padding: var(--space-3) 0 var(--space-4);
    border-top: 1px solid var(--border-on-dark);
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: var(--ls-allcaps);
    text-transform: uppercase;
    color: var(--fg-on-dark-3);
    position: relative;
    z-index: 1;
  }

  .chapter__caption strong {
    color: var(--color-warm);
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .chapter__body {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .chapter__inner {
      min-height: 66vh;
    }
  }
</style>

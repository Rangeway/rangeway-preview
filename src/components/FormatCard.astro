---
interface Props {
  name: string;
  tagline: string;
  description: string;
  image: string;
  imageAlt: string;
  href: string;
  /** Folio index shown in the figure caption, e.g. "01" */
  num?: string;
  /** Plate caption, e.g. "Waystation · Joshua Tree" */
  caption?: string;
}
const { name, tagline, description, image, imageAlt, href, num, caption } = Astro.props;
---

<a class="fmt-entry reveal" href={href}>
  <figure class="fig">
    <div class="fig__frame fmt-entry__frame">
      <img src={image} alt={imageAlt} loading="lazy" />
    </div>
    <figcaption class="fig__caption">
      <span>{caption ?? name}</span>
    </figcaption>
  </figure>
  <div class="fmt-entry__body">
    <h3>{name}</h3>
    <p class="fmt-entry__tagline">{tagline}</p>
    <p class="fmt-entry__desc">{description}</p>
    <span class="arrow-link">
      Explore {name}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12" />
        <polyline points="13 6 19 12 13 18" />
      </svg>
    </span>
  </div>
</a>

<style>
  .fmt-entry {
    display: block;
    color: var(--color-text);
  }

  .fmt-entry:hover {
    color: var(--color-text);
  }

  .fmt-entry__frame {
    aspect-ratio: 4 / 3;
  }

  .fmt-entry__frame img {
    transition: transform 0.7s var(--ease-out);
  }

  .fmt-entry:hover .fmt-entry__frame img {
    transform: scale(1.035);
  }

  .fmt-entry__body {
    margin-top: var(--space-5);
  }

  .fmt-entry__body h3 {
    font-size: clamp(1.7rem, 2.6vw, 2.3rem);
    font-weight: 800;
    letter-spacing: var(--ls-tight);
  }

  .fmt-entry__tagline {
    margin: var(--space-2) 0 var(--space-4);
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent-on-light);
  }

  .fmt-entry__desc {
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 48ch;
  }

  .fmt-entry:hover .arrow-link {
    color: var(--accent-on-light);
  }

  .fmt-entry:hover .arrow-link svg {
    transform: translateX(3px);
  }
</style>

---
import "@fontsource/raleway/400.css";
import "@fontsource/raleway/500.css";
import "@fontsource/raleway/600.css";
import "@fontsource/raleway/700.css";
import "@fontsource/raleway/800.css";
import "@fontsource/source-sans-3/300.css";
import "@fontsource/source-sans-3/400.css";
import "@fontsource/source-sans-3/600.css";
import "@fontsource/source-sans-3/700.css";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../config";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  bodyClass?: string;
}

const {
  title = "Rangeway · Travel farther, stop better.",
  description = SITE.description,
  image = "/images/waystation-hawaii.jpg",
  bodyClass = ""
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();
const siteOrigin = Astro.site?.toString().replace(/\/$/, "") ?? "https://preview.rangeway.co";

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.name,
  legalName: SITE.legalName,
  url: siteOrigin,
  logo: `${siteOrigin}/favicon.svg`,
  description: SITE.description,
  email: SITE.email,
  telephone: SITE.phone,
  address: {
    "@type": "PostalAddress",
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.city,
    addressRegion: SITE.address.region,
    postalCode: SITE.address.postal,
    addressCountry: SITE.address.country
  },
  sameAs: [
    "https://instagram.com/RangewayEV",
    "https://www.linkedin.com/company/rangewayenergy",
    "https://x.com/RangewayEV",
    "https://newsroom.rangeway.co",
    "https://fieldnotes.rangeway.co"
  ],
  contactPoint: [
    {
      "@type": "ContactPoint",
      contactType: "customer service",
      email: "hello@rangeway.co",
      telephone: SITE.phone,
      areaServed: "US",
      availableLanguage: "English"
    },
    {
      "@type": "ContactPoint",
      contactType: "investor relations",
      email: "investors@rangeway.co",
      areaServed: "US",
      availableLanguage: "English"
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {SITE.noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Rangeway" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />

    <script is:inline defer src="https://tinylytics.app/embed/9_N5xEnQSTdibXFSDoqf.js"></script>
  </head>
  <body class={bodyClass}>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <style is:global>
      .skip-link {
        position: absolute;
        top: -40px;
        left: 12px;
        background: var(--color-charcoal);
        color: var(--color-cream);
        padding: 8px 14px;
        border-radius: 4px;
        z-index: 100;
        font-family: var(--font-heading);
        font-size: 0.85rem;
      }
      .skip-link:focus {
        top: 12px;
      }
      body {
        padding-top: 0;
      }
      body:not(.has-hero) main {
        padding-top: calc(var(--nav-height) + 24px);
      }
    </style>

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: "0px 0px -60px 0px" }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>

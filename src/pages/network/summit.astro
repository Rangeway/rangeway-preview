---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import FormatNav from "../../components/FormatNav.astro";
import ResponsiveImage from "../../components/ResponsiveImage.astro";
import { LINKS } from "../../config";

const experiences = [
  {
    title: "Arrive at a destination, not a stop.",
    body: "Summit is sited at places worth staying, with dark skies, quiet ground, and horizons you remember. You pull in to recharge and find yourself unwilling to leave."
  },
  {
    title: "Rest in a modular Lookout.",
    body: "Each Lookout is a small, considered space of its own, with warm materials, generous glass, and a bed made with hospitality instincts. Designed to be moved, but sited to stay."
  },
  {
    title: "Gather at the clubhouse.",
    body: "The clubhouse is the central hub of every Summit, with a fire, a long table, and a kitchen with real food where conversation tends to happen on its own."
  },
  {
    title: "Charge off the grid.",
    body: "Every Summit is fully off-grid solar, with power native to the land and charging that's quiet, clean, and unobtrusive by design."
  }
];
---

<BaseLayout
  title="Summit · Rangeway"
  description="Where the road meets rest. Modular Lookouts, a central clubhouse, and fully off-grid solar charging."
  image="/images/summit-1.jpg"
>
  <PageHero
    eyebrow="Summit"
    title="Where the road meets rest."
    lede="A hospitality-first destination where the stop itself becomes part of the journey, with modular Lookouts, a central clubhouse, and fully off-grid solar."
    image="/images/summit-1.jpg"
    imageAlt="A Summit Lookout at dusk"
    caption="Summit Lookout at dusk"
  />

  <FormatNav current="summit" />

  <section class="section">
    <div class="container">
      <div class="kicker reveal">
        <span class="kicker__label">What Summit Is</span>
      </div>
      <div class="summit-intro reveal">
        <h2>The stop that becomes the trip.</h2>
        <div class="summit-intro__body">
          <p>
            Summit is Rangeway's hospitality north star. It is the format we build when charging
            is no longer the point, because the stop itself is the reason you came. A weekend, a
            way to break up a long drive, a night under real darkness.
          </p>
          <p class="muted">
            Everything we know about how hotels feel at their best lives here. The lighting is
            careful. The materials are honest. The service is present when you want it and
            invisible when you don't.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section summit-experiences">
    <div class="container">
      <div class="kicker reveal">
        <span class="kicker__label">The Experience</span>
      </div>
      <div class="section-head reveal">
        <h2>Four ideas that shape every Summit.</h2>
      </div>
      <div class="summit-experiences__list">
        {experiences.map((e) => (
          <div class="index-row reveal">
            <h3>{e.title}</h3>
            <p>{e.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="kicker reveal">
        <span class="kicker__label">Gallery</span>
      </div>
      <div class="summit-gallery">
        <figure class="fig reveal summit-gallery__lead">
          <div class="fig__frame summit-gallery__frame summit-gallery__frame--wide">
            <ResponsiveImage src="/images/summit-solar-aerial.jpg" alt="Aerial view of a Summit with clubhouse, Lookouts, and off-grid solar array in the desert" loading="lazy" />
          </div>
          <figcaption class="fig__caption">
            <span>Summit from above · Off-grid solar</span>
          </figcaption>
        </figure>
        <figure class="fig reveal">
          <div class="fig__frame summit-gallery__frame">
            <ResponsiveImage src="/images/summit-clubhouse-mountains.jpg" alt="A Summit clubhouse with charging canopy and desert mountains behind" loading="lazy" />
          </div>
          <figcaption class="fig__caption">
            <span>The clubhouse</span>
          </figcaption>
        </figure>
        <figure class="fig reveal">
          <div class="fig__frame summit-gallery__frame">
            <ResponsiveImage src="/images/summit-2.jpg" alt="Summit Lookout interior" loading="lazy" />
          </div>
          <figcaption class="fig__caption">
            <span>Lookout interior</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section band-dark">
    <div class="container">
      <div class="kicker reveal">
        <span class="kicker__label">The Summit Standard</span>
      </div>
      <div class="summit-pillars">
        <h2 class="reveal">Built on three convictions.</h2>
        <div class="summit-pillars__list">
          <div class="index-row reveal">
            <h3>Hospitality over infrastructure</h3>
            <p>Summit is a hotel-quality experience that happens to include a charger. The balance never shifts.</p>
          </div>
          <div class="index-row reveal">
            <h3>Site-specific architecture</h3>
            <p>Every Summit is designed for its setting. Materials, orientation, and palette are drawn from the land.</p>
          </div>
          <div class="index-row reveal">
            <h3>Genuinely off-grid</h3>
            <p>Fully off-grid solar, with a commitment that is not performative. The network does not need to plug in to plug in.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="kicker reveal">
        <span class="kicker__label">Stay Connected</span>
      </div>
      <div class="summit-follow reveal">
        <h2>First access to Summit openings.</h2>
        <div class="summit-follow__side">
          <p>
            Summit locations are small and intentional. Field Notes subscribers hear first when a
            new property opens for stays.
          </p>
          <a class="btn btn-primary" href={LINKS.fieldNotes} target="_blank" rel="noopener noreferrer">
            Subscribe to Field Notes
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="13 6 19 12 13 18" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .summit-intro {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--space-6) clamp(48px, 7vw, 120px);
    align-items: start;
  }

  .summit-intro h2 {
    max-width: 13ch;
  }

  .summit-intro__body p {
    font-size: var(--fs-body-lg);
    line-height: 1.7;
    margin: 0 0 var(--space-5);
    max-width: 48ch;
  }

  .summit-intro__body p:last-child {
    margin-bottom: 0;
  }

  .summit-experiences__list {
    border-bottom: 1px solid var(--color-border);
  }

  .summit-gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(24px, 3vw, 48px);
  }

  .summit-gallery__lead {
    grid-column: 1 / -1;
  }

  .summit-gallery__frame {
    aspect-ratio: 4 / 3;
  }

  .summit-gallery__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .summit-gallery__frame--wide {
    aspect-ratio: 21 / 9;
  }

  .summit-pillars h2 {
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  .summit-pillars__list {
    border-bottom: 1px solid var(--border-on-dark);
  }

  .summit-follow {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--space-6) clamp(48px, 7vw, 120px);
    align-items: end;
  }

  .summit-follow__side p {
    margin: 0 0 var(--space-6);
    color: var(--color-text-muted);
    font-size: 1.08rem;
    line-height: 1.7;
    max-width: 44ch;
  }

  @media (max-width: 900px) {
    .summit-intro,
    .summit-follow {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .summit-gallery {
      grid-template-columns: 1fr;
    }

    .summit-gallery__frame--wide {
      aspect-ratio: 16 / 10;
    }
  }
</style>

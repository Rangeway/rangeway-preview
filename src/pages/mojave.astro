---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { LINKS } from "../config";

const phaseOne = [
  {
    title: "Charging under bamboo.",
    body: "An open-bay charging plaza beneath a custom canopy of structurally engineered bamboo, where pulling in feels like pulling up to a property, not a parking lot."
  },
  {
    title: "Solar that's already running.",
    body: "On-site solar generation and battery energy storage, integrated into a single off-grid platform that Carbon DC already operates at sites across North America."
  },
  {
    title: "Food from our food truck.",
    body: "Fresh food and drinks served from our on-site electric food truck, because you deserve more than a vending machine while you wait."
  },
  {
    title: "A lounge from day one.",
    body: "A climate-controlled mobile lounge, solar-powered and built for the desert, giving drivers a comfortable place to sit, cool off, and wait from the day we open."
  },
  {
    title: "A site shaped by place.",
    body: "Native high-desert landscaping, shaded seating that holds the afternoon, and a layout designed to read as part of the Mojave Desert, not bolted onto it."
  }
];

const howItWorks = [
  {
    title: "Solar panels generate the power.",
    body: "A ground-mounted solar array captures Mojave sunlight across several acres of dedicated solar field, in one of the strongest solar-resource areas in the United States."
  },
  {
    title: "Batteries store it.",
    body: "A battery energy storage system holds the energy and manages load, ensuring consistent charging power regardless of time of day or cloud cover."
  },
  {
    title: "Chargers deliver it.",
    body: "Ultra-fast DC charging ports dispense the stored solar energy directly to your vehicle, and the entire system operates independently of the electrical grid."
  }
];
---

<BaseLayout
  title="Rangeway Mojave · The First Rangeway Location"
  description="Off-grid, solar-powered ultra-fast EV charging is coming to the CA-14 corridor in the Antelope Valley. Rangeway Mojave is the first location, with launch coming in 2027."
  image="/images/basecamp-rosamond.jpg"
>
  <PageHero
    eyebrow="The First Rangeway Location"
    title="Rangeway Mojave."
    lede="Off-grid, solar-powered ultra-fast charging on the CA-14 corridor, with launch coming in 2027."
    image="/images/basecamp-rosamond.jpg"
    imageAlt="Aerial view of Rangeway Mojave at dusk with solar canopy, battery storage, and charging plaza beside the highway"
    caption="Rangeway Mojave · Antelope Valley, California"
    scrim="strong"
  >
    <div class="mojave-hero__ctas">
      <a class="btn btn-warm" href={LINKS.mojaveMicrosite} target="_blank" rel="noopener">
        Visit the microsite
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="13 6 19 12 13 18" />
        </svg>
      </a>
      <a class="btn btn-ghost" href={LINKS.fieldNotes} target="_blank" rel="noopener">
        Subscribe to Field Notes
      </a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="kicker reveal">
        <span class="kicker__label">Why Here</span>
      </div>
      <div class="mojave-corridor reveal">
        <h2>The corridor that's been waiting.</h2>
        <div class="mojave-corridor__body">
          <p>
            The CA-14 corridor connects the Los Angeles basin to the high desert and points
            north. It is the daily commute for the aerospace and defense workforce at Edwards
            Air Force Base, Northrop Grumman, Lockheed Martin, Boeing, NASA, and Virgin
            Galactic, and on weekends, it carries travelers heading to the Eastern Sierra and
            beyond.
          </p>
          <p>
            It is one of the busiest single corridors in California without a hospitality-led
            charging stop. The drivers who use it are technically literate and early to EV
            adoption, and they drive this stretch every day. Right now, they have nowhere to
            charge in a place worth waiting in. Rangeway Mojave changes that.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="mojave-quote section">
    <div class="container">
      <div class="mojave-quote__grid">
        <div class="mojave-quote__text reveal">
          <blockquote class="pullquote">
            In a desert corridor where summer afternoons run hot enough to make charging
            miserable in any open lot, <em>indoor comfort is not an amenity, it is the
            product.</em>
          </blockquote>
          <p class="mojave-quote__attr">Zak Winnick, Founder and CEO</p>
        </div>
        <figure class="fig reveal">
          <div class="fig__frame mojave-quote__frame">
            <img
              src="/images/mojave-canopy-dusk.jpg"
              alt="The Rangeway Mojave charging canopy at dusk, with arched timber bays lit from within, vehicles charging, and the desert sunset behind"
              loading="lazy"
            />
          </div>
          <figcaption class="fig__caption">
            <strong>Render</strong>
            <span>The charging plaza at dusk</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="kicker reveal">
        <span class="kicker__label">Phase I</span>
      </div>
      <div class="section-head reveal">
        <h2>Built from the ground up, powered by the sun.</h2>
        <p class="section-head__lede">
          Engineered by <a class="mojave-link" href="https://carbondc.io" target="_blank" rel="noopener">Carbon DC</a>,
          whose off-grid platform is already operating at multiple sites across California's
          desert corridors.
        </p>
      </div>

      <div class="mojave-phase-list">
        {phaseOne.map((item, i) => (
          <div class="index-row reveal">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>

      <figure class="fig mojave-aerial reveal">
        <div class="fig__frame mojave-aerial__frame">
          <img
            src="/images/mojave-site-aerial.jpg"
            alt="Daytime aerial rendering of Rangeway Mojave with the solar field, battery storage, bamboo charging canopy, food truck, and shaded seating beside the CA-14"
            loading="lazy"
          />
        </div>
        <figcaption class="fig__caption">
          <strong>Plate</strong>
          <span>Phase I concept · Solar field, battery storage, charging plaza, and food truck seating</span>
        </figcaption>
      </figure>

      <p class="mojave-phase2 reveal">
        Phase II grows the mobile lounge into the full Basecamp experience: a permanent,
        climate-controlled building with a staffed cafe, comfortable seating, comfortable
        restrooms, and on-site coffee roasting from
        <a class="mojave-link" href="https://redcanyonroasting.co" target="_blank" rel="noopener">Red Canyon Roasting Company</a>.
        The lounge grows with the site.
      </p>
    </div>
  </section>

  <section class="section section-cream">
    <div class="container">
      <div class="kicker reveal">
        <span class="kicker__label">How It Works</span>
      </div>
      <div class="section-head reveal">
        <h2>Sunlight in, electrons out, grid optional.</h2>
        <p class="section-head__lede">
          This is not experimental technology. We are deploying a proven platform, not testing
          a prototype.
        </p>
      </div>

      <div class="mojave-how-list">
        {howItWorks.map((step, i) => (
          <div class="index-row reveal">
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        ))}
      </div>

      <div class="mojave-how__cta reveal">
        <a class="btn-link" href="https://carbondc.io" target="_blank" rel="noopener">
          Learn more about Carbon DC
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17L17 7" />
            <polyline points="7 7 17 7 17 17" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="section band-dark">
    <div class="container">
      <div class="kicker reveal">
        <span class="kicker__label">The Full Story</span>
      </div>
      <div class="mojave-story reveal">
        <h2>Every network starts with one site. This is ours.</h2>
        <div class="mojave-story__side">
          <p>
            Visit the Rangeway Mojave microsite for the full story: site stats, how the
            off-grid platform works, the vision behind the network, and how to follow
            construction progress.
          </p>
          <div class="mojave-story__ctas">
            <a class="btn btn-warm" href={LINKS.mojaveMicrosite} target="_blank" rel="noopener">
              Visit Rangeway Mojave
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="13 6 19 12 13 18" />
              </svg>
            </a>
            <a class="btn btn-ghost" href="/network">Explore the Network</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .mojave-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .mojave-story__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .mojave-corridor {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--space-6) clamp(48px, 7vw, 120px);
    align-items: start;
  }

  .mojave-corridor h2 {
    max-width: 13ch;
  }

  .mojave-corridor__body p {
    font-size: var(--fs-body-lg);
    line-height: 1.7;
    margin: 0 0 var(--space-5);
    max-width: 52ch;
  }

  .mojave-corridor__body p:last-child {
    margin-bottom: 0;
  }

  .mojave-quote__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--space-7) clamp(48px, 7vw, 120px);
    align-items: center;
  }

  .mojave-quote__text .pullquote {
    max-width: 22ch;
  }

  .mojave-quote__attr {
    margin: var(--space-5) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    font-family: var(--font-heading);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-muted);
    max-width: 22rem;
  }

  .mojave-quote__frame {
    aspect-ratio: 4 / 3;
  }

  .mojave-link {
    color: var(--accent-on-light);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .mojave-link:hover {
    opacity: 0.85;
  }

  .mojave-phase-list,
  .mojave-how-list {
    border-bottom: 1px solid var(--color-border);
  }

  .mojave-aerial {
    margin-top: clamp(40px, 6vw, 72px);
  }

  .mojave-aerial__frame {
    aspect-ratio: 21 / 9;
  }

  .mojave-phase2 {
    margin: clamp(40px, 6vw, 72px) 0 0;
    font-size: var(--fs-body-lg);
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 62ch;
  }

  .mojave-how__cta {
    margin-top: var(--space-7);
  }

  .mojave-story {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--space-6) clamp(48px, 7vw, 120px);
    align-items: end;
  }

  .mojave-story h2 {
    max-width: 15ch;
  }

  .mojave-story__side p {
    margin: 0 0 var(--space-6);
    color: var(--fg-on-dark-2);
    font-size: 1.08rem;
    line-height: 1.7;
    max-width: 46ch;
  }

  @media (max-width: 900px) {
    .mojave-corridor,
    .mojave-quote__grid,
    .mojave-story {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .mojave-aerial__frame {
      aspect-ratio: 16 / 10;
    }
  }
</style>

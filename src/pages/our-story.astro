---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { LINKS } from "../config";

const values = [
  {
    title: "The stop should be worth the time.",
    body: "If a driver has to wait, we have a responsibility to make the wait good. That is the thesis. Everything else follows."
  },
  {
    title: "Hospitality is a decision, not a feature.",
    body: "Every element of a Rangeway location is evaluated like a hotel operator would evaluate it, from lighting to lobby to lavatory."
  },
  {
    title: "Build where drivers actually go.",
    body: "We plan corridors, not maps. A site is only worth building if it shortens a real trip for a real driver."
  },
  {
    title: "The network should feel like one company.",
    body: "A quiet roadside stop and a weekend destination should feel made by the same hands, with the same voice and the same care."
  }
];
---

<BaseLayout
  title="Our Story · Rangeway"
  description="Rangeway was founded by a hospitality operator with deep experience at flagship properties. We are rebuilding EV charging as hospitality."
  image="/images/basecamp-interior.jpg"
>
  <PageHero
    eyebrow="Our Story"
    title="Hospitality DNA meets EV passion."
    lede="Rangeway is not a charging company with amenities. It is a hospitality company that happens to charge vehicles."
    image="/images/basecamp-interior.jpg"
    imageAlt="Interior of a Rangeway driver's lounge"
    caption="driver's lounge · Basecamp"
  />

  <section class="section">
    <div class="container">
      <div class="kicker reveal">
        <span class="kicker__label">Where We Come From</span>
      </div>
      <div class="story-open reveal">
        <blockquote class="pullquote story-open__quote">
          Drivers are guests. Stops are experiences. <em>The wait is the product.</em>
        </blockquote>
        <div class="story-open__body prose">
          <p>
            Rangeway was founded by a hospitality operator who has spent his career at luxury
            resorts, wellness retreats, and flagship urban hotels. That is an unusual background
            for an EV charging company, and that is the point.
          </p>
          <p>
            It is also only half of the story. Rangeway's founder is equally rooted in the EV
            driver community, as a club director and co-founder. The instincts behind every
            Rangeway decision come from years of running guest experiences at the highest level,
            and from countless conversations with drivers on real road trips.
          </p>
          <p>
            That combination is the conviction behind Rangeway. The EV charging industry has
            treated charging as a utility problem. We believe it is a hospitality problem. We
            know which stops have broken the trip, which lounges never existed, and which
            corridors have been left behind. We have been the drivers stopping at them.
          </p>
          <p>
            So we are building the answer on our own terms. Every location is designed as a
            place you would choose, not a place you tolerate. Every format, whatever its size,
            holds the same hospitality standard. The scale shifts with the road. The care does
            not.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section story-values">
    <div class="container">
      <div class="kicker reveal">
        <span class="kicker__label">What We Believe</span>
      </div>
      <div class="section-head reveal">
        <h2>Four ideas the network is built on.</h2>
      </div>
      <div class="story-values__list">
        {values.map((v) => (
          <div class="index-row reveal">
            <h3>{v.title}</h3>
            <p>{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="kicker reveal">
        <span class="kicker__label">The Team</span>
      </div>
      <div class="story-team reveal">
        <h2>The people behind Rangeway.</h2>
        <div class="story-team__side">
          <p>
            We are a small group of hospitality operators, energy veterans, and EV community
            organizers, building the network together.
          </p>
          <a class="btn-link" href="/team">
            Meet the team
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="13 6 19 12 13 18" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section band-dark">
    <div class="container">
      <div class="kicker reveal">
        <span class="kicker__label">Where We're Going</span>
      </div>
      <div class="section-head reveal">
        <h2>The road ahead.</h2>
        <p class="section-head__lede">
          <a class="story-nda" href="/investors">Qualified investors</a> can review the full
          pipeline under NDA.
        </p>
      </div>
      <div class="story-road__list">
        <div class="index-row reveal">
          <h3>Rangeway Mojave is breaking ground in the Antelope Valley.</h3>
          <p>Off-grid, solar-powered ultra-fast charging on the CA-14 corridor. A bamboo charging canopy and a climate-controlled mobile lounge make the stop comfortable from the day it opens.</p>
          <a class="btn-link story-road__link" href={LINKS.mojaveMicrosite} target="_blank" rel="noopener">
            Visit the Mojave microsite
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="13 6 19 12 13 18" />
            </svg>
          </a>
        </div>
        <div class="index-row reveal">
          <h3>Rangeway St. Louis is taking shape as a joint venture.</h3>
          <p>Rangeway and sustainable structure manufacturer LoüTeq are building it together. The venture will develop premium charging locations across the St. Louis region.</p>
          <a class="btn-link story-road__link" href={LINKS.stLouisPress} target="_blank" rel="noopener">
            Read the announcement
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="13 6 19 12 13 18" />
            </svg>
          </a>
        </div>
        <div class="index-row reveal">
          <h3>Rangeway Hawaii is taking shape as a coastal Waystation.</h3>
          <p>A hospitality-first charging stop designed for island travel, pairing ultra-fast charging with a comfortable driver's lounge and a strong sense of place.</p>
          <a class="btn-link story-road__link" href={LINKS.hawaiiMicrosite} target="_blank" rel="noopener">
            Visit the Hawaii microsite
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="13 6 19 12 13 18" />
            </svg>
          </a>
        </div>
      </div>
      <div class="story-road__cta reveal">
        <a class="btn btn-warm" href="/investors">Request investor briefing</a>
        <a class="btn btn-ghost" href={LINKS.fieldNotes} target="_blank" rel="noopener">Subscribe to Field Notes</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .story-open {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-7) clamp(48px, 7vw, 120px);
    align-items: start;
  }

  .story-open__quote {
    max-width: 16ch;
    position: sticky;
    top: calc(var(--nav-height) + 32px);
  }

  .story-open__body p {
    font-size: var(--fs-body-lg);
    line-height: 1.75;
    max-width: 56ch;
  }

  .story-values__list,
  .story-road__list {
    border-bottom: 1px solid var(--color-border);
  }

  .band-dark .story-road__list {
    border-bottom-color: var(--border-on-dark);
  }

  .story-road__link {
    margin-top: var(--space-4);
  }

  .story-team {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--space-6) clamp(48px, 7vw, 120px);
    align-items: end;
  }

  .story-team__side p {
    margin: 0 0 var(--space-5);
    color: var(--color-text-muted);
    font-size: 1.08rem;
    line-height: 1.7;
    max-width: 44ch;
  }

  .story-nda {
    color: var(--color-warm);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .story-nda:hover {
    color: var(--color-warm-lite);
  }

  .story-road__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-7);
  }

  @media (max-width: 900px) {
    .story-open,
    .story-team {
      grid-template-columns: 1fr;
    }

    .story-open__quote {
      position: static;
    }
  }
</style>

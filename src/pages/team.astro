---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { LINKS } from "../config";

const team = [
  {
    name: "Zak Winnick",
    role: "Founder and CEO",
    bio: "Zak has spent his career operating luxury resorts, wellness retreats, and flagship urban hotels. He is also a longtime EV driver, community organizer, and podcast host, with firsthand insight into what charging actually feels like on a long trip.",
    photo: "/images/team/zak-winnick.jpg",
    linkedin: "https://www.linkedin.com/in/zakwinnick"
  },
  {
    name: "Luke Schüette",
    role: "Director of Design and Construction",
    bio: "Luke leads design and construction for the Rangeway network. A structural systems innovator, Luke chairs ASTM's task group on Structural Engineered Bamboo and holds patents in solar charging structures. He has designed for industry leaders like BMW, Rivian, and Tesla. His solar canopies and lounge structures define the look of every Rangeway destination.",
    photo: "/images/team/luke-schuette.jpg",
    linkedin: "https://www.linkedin.com/in/luke-d-sch%C3%BCette/"
  },
  {
    name: "Theo Reichgelt",
    role: "Brand and Growth",
    bio: "Theo founded Nexxt Industry, Europe's leading eMobility marketing agency, and specializes in charging network brand development and market positioning. He also hosts The eMobility Marketing Podcast.",
    photo: "/images/team/theo-reichgelt.jpg",
    linkedin: "https://www.linkedin.com/in/theoreichgelt/"
  },
  {
    name: "James Regan",
    role: "Finance and Strategy",
    bio: "James has built his career in corporate development and business analytics, and serves as Managing Partner at CapitalWorks. He specializes in infrastructure project financing and capital strategy for the buildout of the Rangeway network.",
    photo: "/images/team/james-regan.jpg",
    linkedin: "https://www.linkedin.com/in/james-regan-913915a/"
  },
  {
    name: "Stephanie McGreevy",
    role: "Policy and Public Capital",
    bio: "Stephanie's career has been in zero-emission vehicle infrastructure, and she is the founder of Open Energy Alliance. She specializes in LCFS optimization and grant funding strategies, including NEVI and state-level incentive programs.",
    photo: "/images/team/stephanie-mcgreevy.jpg",
    linkedin: "https://www.linkedin.com/in/smcgreevy/"
  }
];
---

<BaseLayout
  title="Team · Rangeway"
  description="The people building Rangeway. Hospitality operators, energy veterans, and EV community organizers."
  image="/images/basecamp-interior.jpg"
>
  <PageHero
    eyebrow="Team"
    title="The people behind Rangeway."
    lede="Every decision in this company is made by someone who has run a real property for real guests, or driven a real EV on a real road trip. Usually both."
    image="/images/basecamp-interior.jpg"
    imageAlt="Warm interior of a Rangeway driver's lounge"
    caption="driver's lounge · Basecamp"
  />

  <section class="section">
    <div class="container">
      <div class="kicker reveal">
        <span class="kicker__label">The Team</span>
      </div>
      <ul class="team-list">
        {team.map((m) => (
          <li class="team-row reveal">
            <figure class="fig team-row__fig">
              <div class="fig__frame team-row__frame">
                <ResponsiveImage src={m.photo} alt={`Portrait of ${m.name}`} loading="lazy" />
              </div>
            </figure>
            <div class="team-row__body">
              <h3>{m.name}</h3>
              <p class="team-row__role">{m.role}</p>
              <p class="team-row__bio">{m.bio}</p>
              <a
                class="team-row__linkedin"
                href={m.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${m.name} on LinkedIn`}
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M4.98 3.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM3 9h4v12H3V9zm7 0h3.8v1.7h.06c.53-1 1.83-2.06 3.77-2.06 4.03 0 4.77 2.65 4.77 6.1V21h-4v-5.4c0-1.3-.03-2.98-1.82-2.98-1.82 0-2.1 1.42-2.1 2.88V21h-4V9z" />
                </svg>
                <span>LinkedIn</span>
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section band-dark hiring-section">
    <div class="container">
      <div class="kicker reveal">
        <span class="kicker__label">Join Us</span>
      </div>
      <div class="hiring reveal">
        <h2>We are hiring.</h2>
        <div class="hiring__side">
          <p>
            Rangeway is looking for hospitality operators, site leads, energy engineers, and
            people who care about how a good stop feels. If the thesis rings true, we want to
            hear from you.
          </p>
          <div class="hiring__ctas">
            <a class="btn btn-warm" href="mailto:careers@rangeway.co?subject=Joining%20Rangeway">
              Email careers@rangeway.co
            </a>
            <a class="btn btn-ghost" href={LINKS.linkedinJobs} target="_blank" rel="noopener noreferrer">
              View LinkedIn jobs
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .team-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-bottom: 1px solid var(--color-border);
  }

  .team-row {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 8fr);
    gap: var(--space-5) clamp(24px, 4vw, 64px);
    padding: clamp(32px, 4.5vw, 56px) 0;
    border-top: 1px solid var(--color-border);
    align-items: start;
  }

  .team-row__fig {
    max-width: 280px;
  }

  .team-row__frame {
    aspect-ratio: 4 / 5;
  }

  .team-row__frame :global(img) {
    object-position: center top;
    filter: grayscale(1);
  }

  .team-row__body h3 {
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
    font-weight: 800;
  }

  .team-row__role {
    font-family: var(--font-heading);
    font-size: 0.74rem;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent-on-light);
    font-weight: 700;
    margin: var(--space-2) 0 var(--space-4);
  }

  .team-row__bio {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text);
    margin: 0 0 var(--space-4);
    max-width: 64ch;
  }

  .team-row__linkedin {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-heading);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: var(--ls-allcaps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .team-row__linkedin:hover {
    color: var(--accent-on-light);
  }

  .hiring {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--space-6) clamp(48px, 7vw, 120px);
    align-items: center;
  }

  .hiring-section {
    padding-bottom: 0;
  }

  .hiring__side p {
    margin: 0 0 var(--space-6);
    color: var(--fg-on-dark-2);
    font-size: 1.08rem;
    line-height: 1.7;
    max-width: 44ch;
  }

  .hiring__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  @media (max-width: 900px) {
    .team-row {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .team-row__fig {
      max-width: 220px;
    }

    .hiring {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";

const partnerGroups = [
  {
    title: "Structural and Building",
    partners: [
      {
        name: "LoüTeq",
        role: "Structural and building partner",
        description:
          "Every canopy, lounge, and supporting building across the network is built from LoüTeq's Structural Engineered Bamboo, a carbon-negative material stronger than steel and rapidly renewable. BMW and Rivian use the same system.",
        href: "https://louteq.com",
        logo: "/images/partners/louteq.png"
      }
    ]
  },
  {
    title: "Energy and Infrastructure",
    partners: [
      {
        name: "Carbon DC",
        role: "Energy infrastructure",
        description:
          "Carbon DC is Rangeway's strategic partner on off-grid sites, where solar generation, battery storage, and DC fast charging integrate into a single architecture that operates independently of the utility. At every Summit, Carbon DC powers every Lookout, charger, and clubhouse off-grid.",
        href: "https://carbondc.io",
        logo: "/images/partners/carbondc.png"
      },
      {
        name: "Ekoenergetyka",
        role: "Ultra-fast charging hardware",
        description:
          "Ekoenergetyka brings European engineering to the chargers at the heart of the driver experience. The hardware delivers performance, service life, and a design language worthy of a hospitality-forward site.",
        href: "https://ekoenergetyka.com/america/",
        logo: "/images/partners/ekoenergetyka.png"
      },
      {
        name: "Electric Era",
        role: "Charging hardware and storage",
        description:
          "Electric Era's RetailEdge dispensers bring fast, reliable charging to select Rangeway sites, backed by integrated battery storage that keeps every session quick and consistent.",
        href: "https://electricera.tech",
        logo: "/images/partners/electric-era-trans.png"
      },
      {
        name: "HyWatts",
        role: "Modular off-grid power systems",
        description:
          "HyWatts builds Power Plant-in-a-Box systems that integrate solar, battery storage, and hydrogen-ready generation. Rangeway brings HyWatts in on a project-by-project basis when the grid is slow, expensive, or unavailable.",
        href: "https://hywatts.com",
        logo: "/images/partners/hywatts.webp"
      }
    ]
  },
  {
    title: "Software and Driver Experience",
    partners: [
      {
        name: "ChargeMate",
        role: "24/7 AI driver support",
        description:
          "ChargeMate is the always-on concierge behind every Rangeway charger. AI-led troubleshooting handles most issues immediately and escalates to the Rangeway team when needed, so no driver is ever stuck.",
        href: "https://chargemate.ai",
        logo: "/images/partners/chargemate.jpg"
      },
      {
        name: "Juice",
        role: "Plug-and-charge technology",
        description:
          "Juice powers seamless authentication and session handling at every charger. Drivers arrive, plug in, and go, without apps or friction.",
        href: "https://js.eco",
        logo: "/images/partners/juice.png"
      },
      {
        name: "Monta",
        role: "Charge point management",
        description:
          "Monta is the operational backbone of the network. The platform handles payments, roaming, uptime monitoring, and the infrastructure that keeps every charger connected and every transaction clean.",
        href: "https://monta.com",
        logo: "/images/partners/monta.png"
      },
      {
        name: "WattsUp",
        role: "Predictive maintenance",
        description:
          "WattsUp handles the quiet work that keeps every charger reliable. The platform reads charger telemetry to catch failures before drivers ever feel them, keeping uptime at the level hospitality demands.",
        href: "https://wattsupev.io/",
        logo: "/images/partners/wattsup.png"
      }
    ]
  },
  {
    title: "Hospitality and Amenities",
    partners: [
      {
        name: "Pebble",
        role: "Mobile driver lounges",
        description:
          "Pebble provides the mobile lounges at new Rangeway sites, climate-controlled spaces where drivers and guests can relax, work, and recharge while their vehicle does the same.",
        href: "https://pebblelife.com",
        logo: "/images/partners/pebble-trans.png"
      },
      {
        name: "Rivian",
        role: "Food and coffee",
        description:
          "Rivian supplies the upfitted electric vans that serve as Rangeway's on-site food trucks at early sites, run by local operators bringing fresh food and coffee.",
        href: "https://rivian.com",
        logo: "/images/partners/rivian.png"
      }
    ]
  }
];
---

<BaseLayout
  title="Partners · Rangeway"
  description="The partners building Rangeway. Energy infrastructure, hardware, structures, software, and support."
  image="/images/waystation-exterior.jpg"
>
  <PageHero
    eyebrow="Partners"
    title="Built with the people who make the experience possible."
    lede="Rangeway is a brand and operating company. We work with technology, infrastructure, and service partners who build the systems behind the driver experience."
    image="/images/waystation-exterior.jpg"
    imageAlt="A Waystation in warm evening light"
    caption="Waystation in evening light"
  />

  <section class="section">
    <div class="container">
      <div class="kicker reveal">
        <span class="kicker__label">Technology and Infrastructure</span>
      </div>
      <div class="section-head reveal">
        <h2>The systems behind the experience.</h2>
      </div>

      {partnerGroups.map((group) => (
        <div class="partner-group">
          <p class="partner-group__title reveal">{group.title}</p>
          <ul class="partner-list">
            {group.partners.map((p) => (
              <li class="partner-row reveal">
                <div class="partner-row__label">
                  <div class="partner-row__mark">
                    {p.logo && (
                      <img src={p.logo} alt={`${p.name} logo`} loading="lazy" />
                    )}
                  </div>
                  <div>
                    <h3>{p.name}</h3>
                    <p class="partner-row__role">{p.role}</p>
                  </div>
                </div>
                <div class="partner-row__body">
                  <p>{p.description}</p>
                  <a class="btn-link" href={p.href} target="_blank" rel="noopener noreferrer">
                    Visit {p.name}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7 17L17 7" />
                      <polyline points="7 7 17 7 17 17" />
                    </svg>
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <p class="partner-disclosure reveal">
        Partner listings reflect Rangeway's current collaborations. Site-specific configurations
        vary by project phase. <a href="https://newsroom.rangeway.co" target="_blank" rel="noopener noreferrer">The Newsroom</a>
        carries public project announcements.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="kicker reveal">
        <span class="kicker__label">Partner With Rangeway</span>
      </div>
      <div class="partner-cta reveal">
        <h2>Want to work with us?</h2>
        <div class="partner-cta__side">
          <p>
            We work with technology providers, energy companies, and service partners who share
            the conviction that charging should be better.
          </p>
          <a class="btn btn-primary" href="mailto:partners@rangeway.co?subject=Partnership%20Inquiry">
            Email partners@rangeway.co
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .partner-group {
    margin-top: clamp(48px, 6vw, 80px);
  }

  .partner-group__title {
    font-family: var(--font-heading);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent-on-light);
    margin: 0 0 var(--space-4);
  }

  .partner-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-bottom: 1px solid var(--color-border);
  }

  .partner-row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-5) clamp(32px, 5vw, 96px);
    padding: clamp(28px, 4vw, 48px) 0;
    border-top: 1px solid var(--color-border);
    align-items: start;
  }

  .partner-row__label {
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }

  .partner-row__mark {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-xs);
    overflow: hidden;
    background: var(--surface-raised);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
  }

  .partner-row__mark img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .partner-row h3 {
    font-size: clamp(1.5rem, 2.2vw, 1.9rem);
    font-weight: 800;
    margin: 0;
  }

  .partner-row__role {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    letter-spacing: var(--ls-allcaps);
    text-transform: uppercase;
    color: var(--color-text-muted);
    font-weight: 700;
    margin: var(--space-2) 0 0;
  }

  .partner-row__body p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text);
    margin: 0 0 var(--space-4);
    max-width: 62ch;
  }

  .partner-cta {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--space-6) clamp(48px, 7vw, 120px);
    align-items: end;
  }

  .partner-cta__side p {
    margin: 0 0 var(--space-6);
    color: var(--color-text-muted);
    font-size: 1.08rem;
    line-height: 1.7;
    max-width: 44ch;
  }

  .partner-cta__side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .partner-cta__side .btn {
    margin: 0;
  }

  .partner-disclosure {
    max-width: 62ch;
    margin: var(--space-6) 0 0;
    color: var(--color-text-muted);
    font-size: var(--fs-body-sm);
  }

  .partner-disclosure a {
    color: var(--accent-on-light);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  @media (max-width: 900px) {
    .partner-row,
    .partner-cta {
      grid-template-columns: 1fr;
    }
  }
</style>

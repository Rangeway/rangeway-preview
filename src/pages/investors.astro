---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { LINKS } from "../config";

const thesis = [
  {
    title: "The charging market is under-served at the top.",
    body: "Public charging is dominated by utility-first operators. No national network is designed for hospitality-leaning drivers or competes on experience. The hospitality category is wide open, and nobody is approaching it."
  },
  {
    title: "Hospitality unlocks new economics.",
    body: "Dwell time is a liability for a utility company and an asset for a hospitality operator. Our model turns the mandatory minutes of a fast-charge stop into revenue, loyalty, and brand."
  },
  {
    title: "The site-level experience is the moat.",
    body: "Hardware commoditizes. Electricity commoditizes. Experience does not. Running a network that feels like a hotel is operationally hard, and that difficulty is the durable advantage."
  },
  {
    title: "Three formats, one brand, one standard.",
    body: "Rangeway scales hospitality across corridor types without compromising on what the network stands for. Waystation, Basecamp, and Summit each earn their place on the map."
  }
];
---

<BaseLayout
  title="Investors · Rangeway"
  description="The investment case for the first hospitality-driven EV charging network in America."
  image="/images/waystation-gualala.png"
>
  <PageHero
    eyebrow="Investors"
    title="A hospitality category the charging industry never built."
    lede="Rangeway is a hospitality brand for EV drivers. Charging is our beachhead, and experience is the business."
    image="/images/waystation-gualala.png"
    imageAlt="A Waystation in the evening light"
    caption="Waystation · Gualala, California"
  >
    <div class="inv-hero__ctas">
      <a class="btn btn-warm" href={LINKS.investorHub} target="_blank" rel="noopener">
        Visit the Investor Hub
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="13 6 19 12 13 18" />
        </svg>
      </a>
      <a class="btn btn-ghost" href="mailto:investors@rangeway.co?subject=Investor%20Briefing%20Request">
        investors@rangeway.co
      </a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="kicker reveal">
        <span class="kicker__label">The Opportunity</span>
      </div>
      <div class="inv-open reveal">
        <blockquote class="pullquote inv-open__quote">
          Charging is a hospitality problem <em>the industry has misread.</em>
        </blockquote>
        <div class="inv-open__body">
          <p>
            EV drivers wait at chargers on every long drive. Today, that wait happens in a
            parking lot. Rangeway is building the first national network designed for the people
            inside the vehicle, not just the vehicle itself, with hospitality operators at the
            helm.
          </p>
          <p class="muted">
            The investment case is simple. Hospitality is a learnable craft, the chargers are a
            solved problem, and the category is wide open. We are building the brand that will
            define it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section inv-recognition">
    <div class="container">
      <div class="kicker reveal">
        <span class="kicker__label">Recognition</span>
      </div>
      <div class="inv-recognition__body reveal">
        <p class="prose-lg">
          Rangeway was named among the next generation of charge point operators in Ohm
          Analytics' Q3 2025 US EV Charging Market Report, and is a quarter-finalist in the
          Pepperdine Most Fundable Companies program.
        </p>
        <div class="inv-recognition__links">
          <a
            class="btn-link"
            href="https://hs-21752392.f.hubspotstarter.net/hubfs/21752392/OhmAnalytics_EVCharging_2025Q3Report_20251211_Sample.pdf"
            target="_blank"
            rel="noopener"
          >
            Read the Ohm Analytics report
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17L17 7" />
              <polyline points="7 7 17 7 17 17" />
            </svg>
          </a>
          <a
            class="btn-link"
            href="https://bschool.pepperdine.edu/events/most-fundable-companies/"
            target="_blank"
            rel="noopener"
          >
            Pepperdine Most Fundable Companies
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17L17 7" />
              <polyline points="7 7 17 7 17 17" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="kicker reveal">
        <span class="kicker__label">The Thesis</span>
      </div>
      <div class="section-head reveal">
        <h2>Four convictions the plan rests on.</h2>
      </div>
      <div class="inv-thesis">
        {thesis.map((t, i) => (
          <div class="index-row reveal">
            <h3>{t.title}</h3>
            <p>{t.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="kicker reveal">
        <span class="kicker__label">The Plan in Context</span>
      </div>
      <div class="inv-plan reveal">
        <h2>Built for scale. Built to last.</h2>
        <div class="inv-plan__body">
          <p>
            The public EV charging market is on a long-term growth curve, and the largest
            single-year expansion in DC fast charging on record just happened. Reliability
            remains the industry's open wound, with public charging too often still failing when
            drivers most need it to work.
          </p>
          <p>
            Rangeway is being built into that gap. The network plan covers multiple formats
            across a multi-state footprint, funded through a combination of equity, site-level
            debt, non-dilutive programs, and partner-funded energy infrastructure. The unit
            economics, corridor strategy, and capital plan live in the full investor briefing.
          </p>
          <p class="muted">
            Request the briefing for the detailed model, site-level projections, and source
            attribution.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="kicker reveal">
        <span class="kicker__label">The Roadmap</span>
      </div>
      <div class="inv-plan reveal">
        <h2>A phased build.</h2>
        <div class="inv-plan__body">
          <p>
            Rangeway is moving through site control and early development now, with first
            revenue coming online in the phase that follows. Network expansion, the first
            Summit, and multi-state operations are built into the longer arc. The detailed
            milestone schedule, including target quarters and capital deployment sequencing, is
            in the investor briefing.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section band-dark">
    <div class="container">
      <div class="kicker reveal">
        <span class="kicker__label">Get in Touch</span>
      </div>
      <div class="inv-cta reveal">
        <h2>Request the investor briefing.</h2>
        <div class="inv-cta__side">
          <p>
            Our investor materials include the market thesis, corridor strategy, format
            economics, partner roster, and capital plan. We share them with serious partners on
            request.
          </p>
          <a class="btn btn-warm" href="mailto:investors@rangeway.co?subject=Investor%20Briefing%20Request">
            Email investors@rangeway.co
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .inv-hero__ctas {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-6);
  }

  .inv-open {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--space-7) clamp(48px, 7vw, 120px);
    align-items: start;
  }

  .inv-open__quote {
    max-width: 18ch;
  }

  .inv-open__body p {
    font-size: var(--fs-body-lg);
    line-height: 1.7;
    margin: 0 0 var(--space-5);
    max-width: 50ch;
  }

  .inv-open__body p:last-child {
    margin-bottom: 0;
  }

  .inv-recognition__body {
    max-width: 760px;
  }

  .inv-recognition__body .prose-lg {
    margin: 0 0 var(--space-5);
  }

  .inv-recognition__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  .inv-thesis {
    border-bottom: 1px solid var(--color-border);
  }

  .inv-plan {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-6) clamp(48px, 7vw, 120px);
    align-items: start;
  }

  .inv-plan h2 {
    max-width: 12ch;
  }

  .inv-plan__body p {
    font-size: var(--fs-body-lg);
    line-height: 1.7;
    margin: 0 0 var(--space-5);
    max-width: 56ch;
  }

  .inv-plan__body p:last-child {
    margin-bottom: 0;
  }

  .inv-cta {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--space-6) clamp(48px, 7vw, 120px);
    align-items: end;
  }

  .inv-cta__side p {
    margin: 0 0 var(--space-6);
    color: var(--fg-on-dark-2);
    font-size: 1.08rem;
    line-height: 1.7;
    max-width: 44ch;
  }

  @media (max-width: 900px) {
    .inv-open,
    .inv-plan,
    .inv-cta {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>

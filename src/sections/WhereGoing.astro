---
import { LINKS } from "../config";

const waypoints = [
  {
    num: "01",
    title: "Rangeway Mojave is breaking ground in the Antelope Valley.",
    body: "Off-grid, solar-powered ultra-fast charging on the CA-14 corridor. Coming 2027."
  },
  {
    num: "02",
    title: "An urban network is taking root in Missouri.",
    body: "Two sites in development."
  },
  {
    num: "03",
    title: "Routes are being charted across Montana.",
    body: ""
  }
];
---

<section class="where section">
  <div class="container">
    <div class="kicker reveal">
      <span class="kicker__label">Where We're Going</span>
    </div>

    <div class="section-head reveal">
      <h2>The road ahead.</h2>
      <p class="section-head__lede">
        <a class="where__nda-link" href="/investors">Qualified investors</a> can review the full
        pipeline under NDA.
      </p>
    </div>

    <div class="where__list">
      {waypoints.map((w) => (
        <div class="index-row reveal">
          <h3>{w.title}</h3>
          <p>{w.body}</p>
        </div>
      ))}
    </div>

    <div class="where__cta reveal">
      <a class="btn btn-primary" href="/mojave">
        Explore Rangeway Mojave
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="13 6 19 12 13 18" />
        </svg>
      </a>
      <a class="btn btn-outline" href="/investors">Request investor briefing</a>
      <a class="btn btn-outline" href={LINKS.fieldNotes} target="_blank" rel="noopener">
        Subscribe to Field Notes
      </a>
    </div>
  </div>
</section>

<style>
  .where__list {
    border-bottom: 1px solid var(--color-border);
  }

  .where__nda-link {
    color: var(--accent-on-light);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .where__nda-link:hover {
    opacity: 0.85;
  }

  .where__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-7);
  }
</style>

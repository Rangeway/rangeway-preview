---
import { LINKS } from "../config";

const waypoints = [
  {
    title: "Rangeway Bozeman",
    corridor: "I-90 · Montana",
    status: "Raising capital",
    statusTone: "progress" as const,
    body: "Premium charging minutes from Bozeman Yellowstone International Airport, at the I-90 Exit 299 interchange. Rangeway is raising capital on Climatize to build it, and anyone can invest.",
    link: LINKS.bozemanMicrosite,
    linkLabel: "Visit the Bozeman microsite"
  },
  {
    title: "Rangeway Mojave",
    corridor: "CA-14 · Antelope Valley",
    status: "Breaking ground",
    statusTone: "active" as const,
    body: "Off-grid, solar-powered ultra-fast charging on the CA-14 corridor. A bamboo charging canopy and a climate-controlled mobile lounge make the stop comfortable from the day it opens.",
    link: LINKS.mojaveMicrosite,
    linkLabel: "Visit the Mojave microsite"
  },
  {
    title: "Rangeway St. Louis",
    corridor: "Midwest joint venture",
    status: "In development",
    statusTone: "progress" as const,
    body: "Rangeway and sustainable structure manufacturer LoüTeq are building it together. The venture will develop premium charging locations across the St. Louis region.",
    link: LINKS.stLouisPress,
    linkLabel: "Read the announcement"
  }
];
---

<section id="where-going" class="where section">
  <div class="container">
    <div class="kicker reveal">
      <span class="kicker__label">Where We're Going</span>
    </div>

    <div class="section-head reveal">
      <h2>First corridors.</h2>
      <p class="section-head__lede">
        Status on the ground today. <a class="where__nda-link" href="/investors">Qualified investors</a> can review the full pipeline under NDA.
      </p>
    </div>

    <p class="where__updated reveal">Last reviewed July 12, 2026. Each project link leads to its latest public update.</p>

    <div class="where__list">
      {waypoints.map((w) => (
        <div class="index-row reveal">
          <div class="where__meta">
            <p class="where__corridor">{w.corridor}</p>
            <span class:list={["where__status", `where__status--${w.statusTone}`]}>{w.status}</span>
          </div>
          <h3>{w.title}</h3>
          <p>{w.body}</p>
          {w.link && (
            <a class="btn-link where__link" href={w.link} target="_blank" rel="noopener noreferrer">
              {w.linkLabel}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="13 6 19 12 13 18" />
              </svg>
            </a>
          )}
        </div>
      ))}
    </div>

    <div class="where__cta reveal">
      <a class="btn btn-primary" href="/network">Explore the Network</a>
      <a class="btn btn-outline" href={LINKS.fieldNotes} target="_blank" rel="noopener noreferrer">
        Subscribe to Field Notes
      </a>
    </div>
  </div>
</section>

<style>
  .where__list {
    border-bottom: 1px solid var(--color-border);
  }

  .where__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .where__corridor {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent-on-light);
  }

  .where__status {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: var(--ls-allcaps);
    text-transform: uppercase;
    border: 1px solid var(--color-border-strong);
    color: var(--color-text-muted);
  }

  .where__status--active {
    border-color: var(--color-warm);
    color: var(--color-ink);
    background: var(--color-warm);
  }

  .where__status--progress {
    border-color: var(--accent-on-light);
    color: var(--accent-on-light);
  }

  .where__link {
    margin-top: var(--space-4);
  }

  .where__updated {
    margin: calc(-1 * var(--space-6)) 0 var(--space-6);
    font-size: var(--fs-body-sm);
    color: var(--color-text-muted);
  }

  .where__nda-link {
    color: var(--accent-on-light);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .where__nda-link:hover {
    opacity: 0.85;
  }

  .where__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-7);
  }
</style>

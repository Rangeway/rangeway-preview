---
import { LINKS } from "../config";

const waypoints = [
  {
    num: "01",
    title: "Rangeway Bozeman is coming to the I-90 corridor in Montana.",
    body: "Premium charging minutes from Bozeman Yellowstone International Airport, at the I-90 Exit 299 interchange. Rangeway is raising capital on Climatize to build it, and anyone can invest.",
    link: LINKS.bozemanMicrosite,
    linkLabel: "Visit the Bozeman microsite"
  },
  {
    num: "02",
    title: "Rangeway Mojave is breaking ground in the Antelope Valley.",
    body: "Off-grid, solar-powered ultra-fast charging on the CA-14 corridor. A bamboo charging canopy and a climate-controlled mobile lounge make the stop comfortable from the day it opens.",
    link: LINKS.mojaveMicrosite,
    linkLabel: "Visit the Mojave microsite"
  },
  {
    num: "03",
    title: "Rangeway St. Louis is taking shape as a joint venture.",
    body: "Rangeway and sustainable structure manufacturer LoüTeq are building it together. The venture will develop premium charging locations in and around St. Louis.",
    link: LINKS.stLouisPress,
    linkLabel: "Read the announcement"
  }
];
---

<section class="where section">
  <div class="container">
    <div class="kicker reveal">
      <span class="kicker__label">Where We're Going</span>
    </div>

    <div class="section-head reveal">
      <h2>The road ahead.</h2>
      <p class="section-head__lede">
        <a class="where__nda-link" href="/investors">Qualified investors</a> can review the full
        pipeline under NDA.
      </p>
    </div>

    <div class="where__list">
      {waypoints.map((w) => (
        <div class="index-row reveal">
          <h3>{w.title}</h3>
          <p>{w.body}</p>
          {w.link && (
            <a class="btn-link where__link" href={w.link} target="_blank" rel="noopener">
              {w.linkLabel}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="13 6 19 12 13 18" />
              </svg>
            </a>
          )}
        </div>
      ))}
    </div>

    <div class="where__cta reveal">
      <a class="btn btn-primary" href="/investors">Request investor briefing</a>
      <a class="btn btn-outline" href={LINKS.fieldNotes} target="_blank" rel="noopener">
        Subscribe to Field Notes
      </a>
    </div>
  </div>
</section>

<style>
  .where__list {
    border-bottom: 1px solid var(--color-border);
  }

  .where__link {
    margin-top: var(--space-4);
  }

  .where__nda-link {
    color: var(--accent-on-light);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .where__nda-link:hover {
    opacity: 0.85;
  }

  .where__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-7);
  }
</style>

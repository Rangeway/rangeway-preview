---
import ResponsiveImage from "../components/ResponsiveImage.astro";
---

<section class="our-story section">
  <div class="container">
    <div class="kicker reveal">
      <span class="kicker__label">Our Story</span>
    </div>

    <div class="our-story__grid">
      <figure class="fig our-story__media reveal">
        <div class="fig__frame our-story__frame">
          <ResponsiveImage
            src="/images/basecamp-interior.jpg"
            alt="Warm interior of a Rangeway driver's lounge"
            loading="lazy"
          />
        </div>
        <figcaption class="fig__caption">
          <strong>Interior</strong>
          <span>driver's lounge · Basecamp</span>
        </figcaption>
      </figure>

      <div class="our-story__text reveal">
        <h2>Hospitality DNA meets EV passion.</h2>
        <p>
          Rangeway sits at the intersection of two worlds. One is a long career in hospitality,
          across luxury resorts, wellness retreats, and flagship urban hotels, where we learned
          what a great stop feels like. The other is a deep presence in the EV driver community,
          leading clubs and hosting podcasts, where we learned what charging could be. Rangeway is
          what happens when those worlds meet.
        </p>
        <a class="btn-link" href="/our-story">
          Read our story
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="13 6 19 12 13 18" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .our-story__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-7) clamp(48px, 7vw, 120px);
    align-items: center;
  }

  .our-story__frame {
    aspect-ratio: 4 / 5;
  }

  .our-story__text h2 {
    margin-bottom: var(--space-5);
    max-width: 14ch;
  }

  .our-story__text p {
    font-size: 1.08rem;
    line-height: 1.75;
    color: var(--color-text);
    max-width: 52ch;
    margin-bottom: var(--space-5);
  }

  @media (max-width: 900px) {
    .our-story__grid {
      grid-template-columns: 1fr;
    }

    .our-story__frame {
      aspect-ratio: 16 / 10;
    }
  }
</style>

---
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { FORMATS } from "../data/site-content";

type FormatDetails = {
  description: string;
  image: string;
  imageAlt: string;
  caption: string;
};

const formatDetails = {
  Waystation: {
    description:
      "Ultra-fast charging paired with a climate-controlled driver's lounge, comfortable restrooms, generous seating, and high-speed Wi-Fi. The heart of the network.",
    image: "/images/waystation-joshua-tree.jpg",
    imageAlt: "A Waystation nestled into the Joshua Tree landscape",
    caption: "Waystation · Regional routes"
  },
  Basecamp: {
    description:
      "Ultra-fast charging, a staffed driver's lounge, and a staffed cafe. Our flagship experience on high-traffic corridors.",
    image: "/images/basecamp-hero-desert.jpg",
    imageAlt: "A Basecamp at dusk with a lit lounge, charging canopy, and desert mountains behind",
    caption: "Basecamp · High-traffic corridors"
  },
  Summit: {
    description:
      "Modular Lookouts, a central clubhouse, and fully off-grid solar charging. A hospitality-first destination where the stop becomes the journey.",
    image: "/images/summit-1.jpg",
    imageAlt: "A Summit Lookout framed by the desert at dusk",
    caption: "Summit · Overnight destinations"
  }
} satisfies Record<(typeof FORMATS)[number]["name"], FormatDetails>;

const formats = FORMATS.map((format) => ({
  ...format,
  ...formatDetails[format.name]
}));
---

<section id="network" class="network section">
  <div class="container">
    <div class="kicker reveal">
      <span class="kicker__label">The Network</span>
    </div>

    <div class="section-head reveal">
      <h2>Three formats. One unwavering standard.</h2>
      <p class="section-head__lede network__lede">
        Every Rangeway location shares the same hospitality DNA. The scale shifts with the
        corridor, the community, and the journey.
      </p>
    </div>

    <div class="network__grid">
      {formats.map((f) => (
        <a class="network__entry reveal" href={f.href}>
          <figure class="fig">
            <div class="fig__frame network__frame">
              <ResponsiveImage src={f.image} alt={f.imageAlt} loading="lazy" />
            </div>
            <figcaption class="fig__caption">
              <span>{f.caption}</span>
            </figcaption>
          </figure>
          <div class="network__entry-body">
            <h3>{f.name}</h3>
            <p class="network__tagline">{f.tagline}</p>
            <p class="network__desc">{f.description}</p>
            <span class="arrow-link">
              Explore {f.name}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="13 6 19 12 13 18" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .network {
    background: var(--color-paper);
  }

  .network__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 2.5vw, 40px);
    align-items: stretch;
  }

  .network__entry {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    overflow: hidden;
    color: var(--color-text);
    border-top: 4px solid var(--color-highway);
    background: var(--color-roadmap);
  }

  .network__entry .fig {
    min-width: 0;
  }

  .network__entry .fig__caption {
    margin-inline: var(--space-5);
    min-width: 0;
  }

  .network__entry .fig__caption span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .network__entry:hover {
    color: var(--color-text);
  }

  .network__frame {
    aspect-ratio: 5 / 4;
    border-radius: 0;
  }

  .network__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease-out);
  }

  .network__entry:hover .network__frame :global(img) {
    transform: scale(1.035);
  }

  .network__entry-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--space-5);
  }

  .network__entry-body h3 {
    font-size: clamp(1.7rem, 2.6vw, 2.3rem);
    font-weight: 800;
    letter-spacing: var(--ls-tight);
  }

  .network__tagline {
    margin: var(--space-2) 0 var(--space-4);
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent-on-light);
  }

  .network__desc {
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 48ch;
  }

  .network__entry-body .arrow-link {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .network__entry:hover .arrow-link {
    color: var(--accent-on-light);
  }

  .network__entry:hover .arrow-link svg {
    transform: translateX(3px);
  }

  @media (max-width: 900px) {
    .network__grid {
      grid-template-columns: 1fr;
    }

    .network__frame {
      aspect-ratio: 16 / 10;
    }
  }
</style>

---
const desktopImage = "/images/hero-mountain-waystation.jpg";
const heroAlt =
  "A concept rendering of the Rangeway Basecamp in Bozeman, Montana, with sunset-lit mountains behind a glowing glass lounge and an EV charging beneath the timber canopy";
---

<section class="hero">
  <div class="hero__nav-field" aria-hidden="true"></div>
  <div class="hero__split">
    <div class="hero__story">
      <p class="hero__kicker">America's first hospitality-driven EV charging network</p>
      <h1 class="hero__headline">
        <span>Travel farther.</span>
        <span>Stop better.</span>
      </h1>
      <p class="hero__lede">
        Built around drivers who plan their journeys with care. Every Rangeway location is
        operated to a hospitality standard. The stop, not the charger, is the point.
      </p>
      <a class="hero__action" href="/network">
        Discover the Network
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="13 6 19 12 13 18" />
        </svg>
      </a>
    </div>

    <figure class="hero__media">
      <picture>
        <source type="image/webp" srcset="/images/hero-mountain-waystation.webp" />
        <img
          src={desktopImage}
          alt={heroAlt}
          width={1672}
          height={941}
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <figcaption>Basecamp concept · Bozeman, Montana</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    grid-template-rows: var(--nav-height) minmax(0, 1fr);
    background: var(--color-highway);
  }

  .hero__nav-field {
    background: var(--color-highway);
  }

  .hero__split {
    position: relative;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 40fr) minmax(0, 60fr);
    overflow: hidden;
    background: var(--color-sun);
  }

  .hero__story {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(48px, 6vw, 96px) var(--gutter);
    color: var(--color-highway);
    background: var(--color-sun);
  }

  .hero__kicker {
    max-width: 42ch;
    margin: 0 0 clamp(28px, 4vw, 56px);
    padding-top: var(--space-3);
    border-top: 1px solid rgb(23 49 62 / 45%);
    font-family: var(--font-heading);
    font-size: var(--fs-eyebrow);
    font-weight: 700;
    line-height: var(--lh-compact);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
  }

  .hero__headline {
    display: flex;
    flex-direction: column;
    max-width: 7ch;
    font-size: clamp(3.6rem, 7.8vw, 8.4rem);
    line-height: 0.86;
    letter-spacing: var(--ls-display);
    color: var(--color-highway);
  }

  .hero__headline span {
    opacity: 0;
    transform: translateY(0.35em);
    animation: heroLine 0.9s var(--ease-out) forwards;
  }

  .hero__headline span:nth-child(2) {
    animation-delay: 0.12s;
  }

  @keyframes heroLine {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__lede {
    max-width: 43ch;
    margin: clamp(28px, 4vw, 48px) 0 var(--space-6);
    font-size: clamp(1rem, 1.25vw, 1.18rem);
    line-height: 1.55;
  }

  .hero__action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    width: fit-content;
    padding: 14px 20px;
    border: 2px solid currentColor;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: var(--ls-allcaps);
    text-transform: uppercase;
  }

  .hero__action:hover {
    color: var(--color-paper);
    background: var(--color-highway);
  }

  .hero__media {
    position: relative;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    background: var(--color-sun);
    clip-path: ellipse(88% 83% at 100% 48%);
  }

  .hero__media :global(picture),
  .hero__media :global(img) {
    width: 100%;
    height: 100%;
  }

  .hero__media :global(img) {
    object-fit: cover;
    object-position: 56% 68%;
  }

  .hero__media figcaption {
    position: absolute;
    right: var(--space-5);
    bottom: var(--space-5);
    padding: 7px 10px;
    color: var(--fg-on-dark-1);
    background: rgb(23 49 62 / 82%);
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: var(--ls-allcaps);
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__headline span {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  @media (max-width: 760px) {
    .hero {
      min-height: 100svh;
      grid-template-rows: var(--nav-height) auto;
    }

    .hero__split {
      grid-template-columns: 1fr;
      grid-template-rows: auto minmax(300px, 44svh);
    }

    .hero__story {
      padding-top: var(--space-7);
      padding-bottom: var(--space-7);
    }

    .hero__kicker {
      margin-bottom: var(--space-6);
    }

    .hero__headline {
      font-size: clamp(3.2rem, 17vw, 5rem);
    }

    .hero__lede {
      margin-top: var(--space-6);
    }

    .hero__media :global(img) {
      object-position: 58% 66%;
    }

    .hero__media {
      clip-path: none;
    }
  }
</style>

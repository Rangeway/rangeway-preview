---
const desktopImage = "/images/hero-mountain-waystation.png";
const mobileImage = "/images/hero-mountain-waystation-mobile.png";
const heroAlt =
  "A Rangeway Waystation at dusk with sunset-lit mountains behind, lounge interior glowing through the glass facade, and a Rivian charging under the timber canopy";
---

<section class="hero">
  <div class="hero__media">
    <picture>
      <source media="(max-width: 720px)" srcset={mobileImage} />
      <img src={desktopImage} alt={heroAlt} fetchpriority="high" />
    </picture>
    <div class="hero__scrim"></div>
  </div>

  <div class="hero__frame container">
    <div class="hero__kicker">
      <span class="hero__kicker-left">Rangeway</span>
      <span class="hero__kicker-right">America's First Hospitality-Driven EV Charging Network</span>
    </div>

    <div class="hero__stage">
      <h1 class="hero__headline">
        <span class="hero__line">Travel</span>
        <span class="hero__line">Farther,</span>
        <span class="hero__line hero__line--warm">Stop Better.</span>
      </h1>
    </div>

    <div class="hero__base">
      <p class="hero__lede">
        Hospitality operators run every location, and the stop, not the charger, is the point.
      </p>
      <div class="hero__ctas">
        <a class="btn btn-warm" href="/network">
          Discover the Network
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="13 6 19 12 13 18" />
          </svg>
        </a>
        <a class="btn btn-ghost" href="/our-story">Our Story</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    color: var(--color-white);
    overflow: hidden;
    isolation: isolate;
    background: var(--color-ink);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 65%;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(23, 21, 20, 0.62) 0%, rgba(23, 21, 20, 0.16) 36%, rgba(23, 21, 20, 0.78) 100%);
  }

  .hero__frame {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-top: calc(var(--nav-height) + 28px);
    padding-bottom: clamp(36px, 5vw, 64px);
  }

  /* Editorial rule across the top of the cover */
  .hero__kicker {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid rgba(251, 247, 241, 0.42);
    font-family: var(--font-heading);
    font-size: var(--fs-eyebrow);
    font-weight: 700;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
  }

  .hero__kicker-left {
    color: var(--color-warm);
  }

  .hero__kicker-right {
    text-align: right;
    color: var(--fg-on-dark-1);
  }

  .hero__stage {
    flex: 1;
    display: flex;
    align-items: flex-end;
  }

  .hero__headline {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: var(--fs-mega);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    color: var(--fg-on-dark-1);
    display: flex;
    flex-direction: column;
  }

  .hero__line {
    display: block;
    opacity: 0;
    transform: translateY(0.35em);
    animation: heroLine 0.9s var(--ease-out) forwards;
  }

  .hero__line:nth-child(2) {
    animation-delay: 0.12s;
  }

  .hero__line:nth-child(3) {
    animation-delay: 0.24s;
  }

  .hero__line--warm {
    color: var(--color-warm);
  }

  @keyframes heroLine {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__base {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    margin-top: clamp(28px, 4vw, 48px);
    padding-top: var(--space-5);
    border-top: 1px solid rgba(251, 247, 241, 0.42);
  }

  .hero__lede {
    margin: 0;
    font-size: clamp(1.05rem, 1.5vw, 1.24rem);
    line-height: 1.6;
    max-width: 42ch;
    color: var(--fg-on-dark-2);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: flex-end;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__line {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  @media (max-width: 820px) {
    .hero__media img {
      object-position: center center;
    }

    .hero__kicker-right {
      display: none;
    }

    .hero__base {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero__ctas {
      justify-content: flex-start;
    }
  }
</style>

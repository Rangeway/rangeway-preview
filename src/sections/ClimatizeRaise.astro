---
import { CLIMATIZE_URL } from "../config";

interface Props {
  /**
   * "feature": cinematic full-bleed band, used directly below the hero
   *             while the campaign is open (CAMPAIGN_MODE on).
   * "standard": quiet editorial section, used when the campaign closes.
   */
  variant?: "feature" | "standard";
}

const { variant = "standard" } = Astro.props;
---

{variant === "feature" ? (
  <section class="raise-feature band-dark">
    <div class="raise-feature__media" aria-hidden="true">
      <img src="/images/basecamp-rosamond.jpg" alt="" loading="lazy" />
      <div class="raise-feature__scrim"></div>
    </div>
    <div class="container raise-feature__inner">
      <div class="kicker reveal">
        <span class="kicker__index">Now Open</span>
        <span class="kicker__label">The Mojave Raise</span>
      </div>
      <div class="raise-feature__grid reveal">
        <h2>Build Rangeway Mojave with us.</h2>
        <div class="raise-feature__side">
          <p>
            Rangeway is raising capital on Climatize to build Rangeway Mojave, the first location
            in the network. The campaign is open to everyone, not just accredited investors.
            Anyone can invest in the first site, starting at the campaign minimum.
          </p>
          <div class="raise-feature__ctas">
            <a class="btn btn-warm" href={CLIMATIZE_URL} target="_blank" rel="noopener">
              Invest in Mojave
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="13 6 19 12 13 18" />
              </svg>
            </a>
            <a class="btn-link" href="/mojave">
              Explore Rangeway Mojave
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="13 6 19 12 13 18" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
) : (
  <section class="raise-standard section">
    <div class="container">
      <div class="kicker reveal">
        <span class="kicker__index">Mojave</span>
        <span class="kicker__label">The First Location</span>
      </div>
      <div class="raise-standard__grid reveal">
        <h2>Build Rangeway Mojave with us.</h2>
        <div class="raise-standard__side">
          <p>
            Rangeway is raising capital on Climatize to build Rangeway Mojave, the first location
            in the network. The campaign is open to everyone, not just accredited investors.
            Anyone can invest in the first site, starting at the campaign minimum.
          </p>
          <div class="raise-standard__ctas">
            <a class="btn btn-warm" href={CLIMATIZE_URL} target="_blank" rel="noopener">
              Invest in Mojave
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="13 6 19 12 13 18" />
              </svg>
            </a>
            <a class="btn-link" href="/mojave">
              Explore Rangeway Mojave
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="13 6 19 12 13 18" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  /* Feature: cinematic interlude on the Rosamond aerial */
  .raise-feature {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: clamp(96px, 12vw, 180px) 0;
  }

  .raise-feature__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .raise-feature__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .raise-feature__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(100deg, rgba(23, 21, 20, 0.92) 0%, rgba(23, 21, 20, 0.7) 55%, rgba(23, 21, 20, 0.82) 100%),
      linear-gradient(180deg, rgba(23, 21, 20, 0.3) 0%, rgba(23, 21, 20, 0) 40%, rgba(23, 21, 20, 0.4) 100%);
  }

  .raise-feature__grid,
  .raise-standard__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--space-6) clamp(48px, 7vw, 120px);
    align-items: end;
  }

  .raise-feature__grid h2 {
    font-size: var(--fs-h1);
    max-width: 14ch;
  }

  .raise-feature__side p {
    margin: 0 0 var(--space-6);
    color: var(--fg-on-dark-2);
    font-size: 1.08rem;
    line-height: 1.7;
    max-width: 46ch;
  }

  .raise-feature__ctas,
  .raise-standard__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
  }

  /* Standard: quiet editorial section */
  .raise-standard__grid h2 {
    max-width: 14ch;
  }

  .raise-standard__side p {
    margin: 0 0 var(--space-6);
    color: var(--color-text-muted);
    font-size: 1.08rem;
    line-height: 1.7;
    max-width: 46ch;
  }

  @media (max-width: 900px) {
    .raise-feature__grid,
    .raise-standard__grid {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>

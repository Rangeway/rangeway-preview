---
---

<section id="comfort" class="comfort band-dark">
  <div class="comfort__media" aria-hidden="true">
    <img
      src="/images/basecamp-interior.jpg"
      alt=""
      loading="lazy"
    />
    <div class="comfort__scrim"></div>
  </div>

  <div class="container comfort__inner">
    <div class="kicker reveal">
      <span class="kicker__label">The Standard</span>
    </div>

    <div class="comfort__grid">
      <div class="comfort__text reveal">
        <h2>The Indoor Comfort Guarantee.</h2>
      </div>
      <div class="comfort__body reveal">
        <p>
          Every Waystation and Basecamp commits to climate-controlled indoor comfort, with
          comfortable restrooms, generous seating, and reliable high-speed Wi-Fi. The lounge is
          part of the standard, not an upsell.
        </p>
        <p>
          At Trailheads, drivers are welcomed by covered canopies, clean restrooms nearby, and
          reliable Wi-Fi. At Summits, the hospitality extends into overnight stays in modular
          Lookouts.
        </p>
      </div>
    </div>

    <p class="comfort__caption reveal">
      <strong>Interior</strong>
      <span>driver's lounge · Basecamp</span>
    </p>
  </div>
</section>

<style>
  .comfort {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: clamp(120px, 15vw, 220px) 0 clamp(48px, 6vw, 80px);
  }

  .comfort__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .comfort__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 65%;
  }

  .comfort__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(23, 21, 20, 0.2) 40%, rgba(23, 21, 20, 0.62) 72%),
      linear-gradient(180deg, rgba(23, 21, 20, 0.78) 0%, rgba(23, 21, 20, 0.5) 45%, rgba(23, 21, 20, 0.88) 100%);
  }

  .comfort__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--space-6) clamp(48px, 7vw, 120px);
    align-items: end;
    padding-bottom: clamp(72px, 10vw, 140px);
  }

  .comfort__text h2 {
    font-size: var(--fs-h1);
    max-width: 12ch;
  }

  .comfort__body p {
    margin: 0 0 var(--space-4);
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--fg-on-dark-2);
    max-width: 44ch;
  }

  .comfort__body p:last-child {
    margin-bottom: 0;
  }

  .comfort__caption {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin: 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-on-dark);
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: var(--ls-allcaps);
    text-transform: uppercase;
    color: var(--fg-on-dark-3);
  }

  .comfort__caption strong {
    color: var(--color-warm);
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .comfort__grid {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
